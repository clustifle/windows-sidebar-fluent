<Window x:Class="Sidebar.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Sidebar" Title="FluentSidebar">
 <Grid x:Name="Root" Padding="10,8,10,10" RowSpacing="8" Background="Transparent" RightTapped="Sidebar_RightTapped">
  <Grid.Resources>
   <DataTemplate x:Key="LauncherTileTemplate"><Grid Width="96" Height="104" Padding="6" Loaded="AppSearchResult_Loaded"><StackPanel Spacing="8"><Grid Width="32" Height="32"><FontIcon x:Name="SearchFallback" Glyph="&#xE8A5;" FontSize="28"/><Image x:Name="SearchIcon" Width="32" Height="32" Visibility="Collapsed"/></Grid><TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12"/></StackPanel></Grid></DataTemplate>
   <DataTemplate x:Key="GadgetGalleryTemplate"><Grid Width="136" Height="144" Padding="8" Loaded="GalleryItem_Loaded"><StackPanel Spacing="6"><FontIcon Glyph="{Binding Glyph}" FontSize="28" HorizontalAlignment="Left"/><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="GadgetEnabledLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate>
   <DataTemplate x:Key="AppSearchResultTemplate"><Grid HorizontalAlignment="Stretch" Padding="8" ColumnSpacing="10" Loaded="AppSearchResult_Loaded"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Width="28" Height="28"><FontIcon x:Name="SearchFallback" Glyph="&#xE8A5;" FontSize="22"/><Image x:Name="SearchIcon" Width="28" Height="28" Visibility="Collapsed"/></Grid><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="14"/></Grid></DataTemplate>
   <Style x:Key="RailButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="6,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
   <Style x:Key="GadgetTile" TargetType="Border"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="LonghornHeader" Grid.Row="0" Visibility="Collapsed" Spacing="4">
   <Button x:Name="LauncherEntry" Content="Apps" Click="OpenLauncher_Click" HorizontalAlignment="Stretch" Visibility="Collapsed" MinHeight="28" Padding="8,2" AutomationProperties.Name="Open app launcher"/>
   <AutoSuggestBox x:Name="LonghornSearch" PlaceholderText="Search for…" QueryIcon="Find" FontSize="12" MinWidth="0" TextMemberPath="Name" ItemTemplate="{StaticResource AppSearchResultTemplate}" MaxSuggestionListHeight="420" TextChanged="LonghornSearch_TextChanged" SuggestionChosen="LonghornSearch_SuggestionChosen" QuerySubmitted="LonghornSearch_QuerySubmitted" AutomationProperties.Name="Search apps or files"/>
  </StackPanel>
  <ScrollViewer x:Name="GadgetScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"><StackPanel x:Name="GadgetStack" Spacing="12">
  <Border x:Name="ClockGadget" Style="{StaticResource GadgetTile}" DoubleTapped="Clock_DoubleTapped"><StackPanel Spacing="4" HorizontalAlignment="Center">
   <Viewbox x:Name="ClockView" Width="96" Height="96"><Canvas x:Name="ClockFace" Width="156" Height="156" AutomationProperties.Name="Analog clock"/></Viewbox>
   <TextBlock x:Name="TimeText" FontSize="24" FontWeight="SemiLight" HorizontalAlignment="Center"/>
   <TextBlock x:Name="DateText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="190"/>
   <TextBlock x:Name="ClockCaption" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="190"/>
  </StackPanel></Border>

   <Border x:Name="CalendarGadget" Style="{StaticResource GadgetTile}"><StackPanel Spacing="4">
    <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="MonthText" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Column="1" Click="PreviousMonth_Click" AutomationProperties.Name="Previous month" ToolTipService.ToolTip="Previous month" Width="24" Height="24" MinWidth="24" Padding="0" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
     <Button Grid.Column="2" Click="NextMonth_Click" AutomationProperties.Name="Next month" ToolTipService.ToolTip="Next month" Width="24" Height="24" MinWidth="24" Padding="0" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
    </Grid>
    <Grid x:Name="CalendarGrid" RowSpacing="2" ColumnSpacing="1"/>
    <Grid><TextBlock x:Name="CalendarTodayText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><Button x:Name="CalendarTodayButton" Content="Today" Click="Today_Click" HorizontalAlignment="Right" MinHeight="24" Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0"/></Grid>
   </StackPanel></Border>
   <Border x:Name="TimerCategory" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8"><TextBlock Text="Timer" FontWeight="SemiBold"/>
    <TextBlock x:Name="TimerText" Text="05:00" FontSize="28" HorizontalAlignment="Center"/>
    <NumberBox x:Name="TimerMinutes" Header="Minutes" Value="5" Minimum="1" Maximum="180" SpinButtonPlacementMode="Compact"/>
    <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="TimerStart" Content="Start" Click="Timer_Click"/><Button Content="Reset" Click="TimerReset_Click"/></StackPanel>
   </StackPanel></Border>
   <Border x:Name="StorageCategory" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8"><TextBlock Text="Storage" FontWeight="SemiBold"/><TextBlock x:Name="StorageText" TextWrapping="Wrap" FontSize="12"/><ProgressBar x:Name="StorageBar" Maximum="100" AutomationProperties.Name="System drive usage"/></StackPanel></Border>
   <Border x:Name="NotesGadget" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8"><TextBlock Text="Notes" FontWeight="SemiBold"/>
    <TextBox x:Name="NotesBox" PlaceholderText="Write a note…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="180" TextChanged="Notes_Changed" AutomationProperties.Name="Notes"/>
    <TextBlock x:Name="SaveStatus" Text="Saved on this device" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel></Border>
   <Border x:Name="SystemGadget" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8"><TextBlock Text="CPU meter" FontWeight="SemiBold"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4"><Grid Height="62"><ProgressRing x:Name="CpuRing" IsIndeterminate="False" Width="62" Height="62" Maximum="100" AutomationProperties.Name="CPU usage"/><TextBlock x:Name="CpuPercent" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/></Grid><TextBlock Text="CPU" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
     <StackPanel Grid.Column="1" Spacing="4"><Grid Height="62"><ProgressRing x:Name="MemoryRing" IsIndeterminate="False" Width="62" Height="62" Maximum="100" AutomationProperties.Name="Memory usage"/><TextBlock x:Name="MemoryPercent" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/></Grid><TextBlock Text="Memory" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
    </Grid>
    <TextBlock x:Name="CpuText" Visibility="Collapsed"/><ProgressBar x:Name="CpuBar" Maximum="100" Visibility="Collapsed"/>
    <TextBlock x:Name="MemoryText" FontSize="11" TextWrapping="Wrap"/><ProgressBar x:Name="MemoryBar" Maximum="100" Visibility="Collapsed"/>
   </StackPanel></Border>
   <Border x:Name="SlideShowGadget" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8"><TextBlock Text="Slide show" FontWeight="SemiBold"/>
    <Grid Height="130" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Image x:Name="SlideImage" Stretch="UniformToFill"/><TextBlock x:Name="SlideHint" Text="Choose a picture folder" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid>
    <TextBlock x:Name="SlideName" FontSize="11" TextTrimming="CharacterEllipsis"/>
    <Grid ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button Click="SlidePrevious_Click" AutomationProperties.Name="Previous picture" Padding="6"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
     <Button Grid.Column="1" x:Name="SlidePlay" Click="SlidePlay_Click" Content="Pause" IsEnabled="False" FontSize="12" Padding="6,4"/>
     <Button Grid.Column="2" Click="SlideNext_Click" AutomationProperties.Name="Next picture" Padding="6"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
     <Button Grid.Column="3" Click="ChooseSlideFolder_Click" AutomationProperties.Name="Choose picture folder" ToolTipService.ToolTip="Choose picture folder" HorizontalAlignment="Right" Padding="6"><FontIcon Glyph="&#xE8B7;" FontSize="14"/></Button>
    </Grid>
   </StackPanel></Border>
   <Border x:Name="PuzzleGadget" Style="{StaticResource GadgetTile}"><StackPanel Spacing="6"><TextBlock Text="Picture puzzle" FontWeight="SemiBold"/>
    <Border x:Name="PuzzleFrame" Padding="2" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Stretch" SizeChanged="PuzzleFrame_SizeChanged"><Grid x:Name="PuzzleStage" HorizontalAlignment="Center"><Grid x:Name="PuzzleBoard" Height="174" RowSpacing="2" ColumnSpacing="2" KeyDown="PuzzleBoard_KeyDown"><Border x:Name="PuzzleGap" Padding="1" CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.Name="Empty space"/></Grid><Canvas x:Name="PuzzleMergeLayer" Visibility="Collapsed" IsHitTestVisible="False"/><Image x:Name="PuzzleCompletedImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Completed puzzle picture"/></Grid></Border>
    <TextBlock x:Name="PuzzleStatus" Text="Slide a tile into the empty space" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite"/>
    <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="PuzzleShuffle" Click="PuzzleShuffle_Click" Content="Shuffle" FontSize="12" Padding="8,4" MinWidth="0" Height="28" HorizontalAlignment="Stretch"/>
     <Button x:Name="PuzzlePreview" Grid.Column="1" Click="PreviewPuzzle_Click" AutomationProperties.Name="Preview completed picture" ToolTipService.ToolTip="Preview completed picture" Width="28" Height="28" MinWidth="0" Padding="5" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE890;" FontSize="14"/></Button>
     <Button Grid.Column="2" Click="PuzzlePictureOptions_Click" AutomationProperties.Name="Puzzle picture options" ToolTipService.ToolTip="Picture options" Width="28" Height="28" MinWidth="0" Padding="5" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE8B9;" FontSize="14"/></Button>
    </Grid>
   </StackPanel></Border>
   <Border x:Name="FeedsGadget" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8"><Grid><TextBlock Text="Feed headlines" FontWeight="SemiBold"/><Button Click="ConfigureFeed_Click" Content="Edit" FontSize="11" HorizontalAlignment="Right"  Padding="4" Background="Transparent" BorderThickness="0"/></Grid>
    <TextBlock x:Name="FeedStatus" Text="Add an RSS or Atom feed" TextWrapping="Wrap" FontSize="11"/>
    <StackPanel x:Name="FeedItems" Spacing="6"/>
    <Button Click="RefreshFeed_Click" Content="Refresh" Padding="8,4" HorizontalAlignment="Left"/>
   </StackPanel></Border>
   <Border x:Name="LaunchCategory" Style="{StaticResource GadgetTile}"><StackPanel Spacing="8">
    <Grid><TextBlock Text="Quick launch" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Click="CustomizeLaunch_Click" Content="Edit" FontSize="11" HorizontalAlignment="Right"  Padding="4" Background="Transparent" BorderThickness="0"/></Grid>
    <Grid x:Name="LaunchItems" RowSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel x:Name="PageControls" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
   <Button x:Name="PreviousPage" Click="PreviousPage_Click" AutomationProperties.Name="Previous gadget page" Width="28" Height="28" MinWidth="0" Padding="6" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
   <Button x:Name="NextPage" Click="NextPage_Click" AutomationProperties.Name="Next gadget page" Width="28" Height="28" MinWidth="0" Padding="6" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
   <Button Click="Add_Click" AutomationProperties.Name="Add or customize gadgets" ToolTipService.ToolTip="Add gadgets" Width="28" Height="28" MinWidth="0" Padding="6" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE710;" FontSize="12"/></Button>
   <TextBlock x:Name="PageIndicator" Visibility="Collapsed"/>
  </StackPanel>
  <StackPanel x:Name="LonghornPanel" Grid.Row="1" Visibility="Collapsed" Spacing="2">
   <Border x:Name="LonghornPinsSection" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,3,0,0"><ScrollViewer MaxHeight="58" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="LonghornPins" AutomationProperties.Name="Pinned apps" RowSpacing="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid></ScrollViewer></Border>

  </StackPanel>
  <StackPanel x:Name="LonghornBottom" Grid.Row="5" Visibility="Collapsed" Spacing="2">
   <StackPanel x:Name="LonghornClockDock" AllowDrop="True" MinHeight="12" AutomationProperties.Name="Bottom clock dock"/>
  </StackPanel>
  <TextBlock Grid.Row="4" x:Name="PanelStatus" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid>
</Window>
